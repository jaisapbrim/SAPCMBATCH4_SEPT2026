            "Data": {
              "sourceCode": "map<string,boolean> mapDupCheck;
beginBatch{
    mapDupCheck = mapCreate(string,boolean);
}
consume {
    string key = (string)input.RecordSequenceNumber +\"_\"+input.UsageRecordID;
    
    if(mapContains(mapDupCheck,key)){
        //duplicate detected    
        udrRoute(input,\"dup\"); 
    }else{
        //unique record, process it and store in map for future comparison
        mapSet(mapDupCheck,key,true);  
        udrRoute(input,\"uni\");  
    }
}",
