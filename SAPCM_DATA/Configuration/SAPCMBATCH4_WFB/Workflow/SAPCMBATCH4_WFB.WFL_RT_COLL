        debug(\"Current state:\"+\"\\n\"+input);
        udrRoute((WorkflowStateUDR)input,\"ack\");
    }else if(instanceOf(input,ConsumeCycleUDR)){
        udrRoute((ConsumeCycleUDR)input,\"ack\");
        debug(\"Received data at realtime workflow:\"+\"\\n\"+input);
    }
}",
