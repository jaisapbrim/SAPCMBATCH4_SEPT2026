            "Type": 1,
            "Classname": "com.digitalroute.wfc.analysis.AnalysisRealtimeInsp",
            "Data": {
              "sourceCode": "import ultra.wfb;
int loadId = 1;
synchronized void setLoadId(int id){
    loadId = id;
}
consume {
    ConsumeCycleUDR cCycle = udrCreate(ConsumeCycleUDR);
    cCycle.Data = input;
    cCycle.LoadId = loadId;
    if(loadId == 1)setLoadId(2); else setLoadId(1);
    //cCycle.Broadcast = true;
    debug(cCycle);
    udrRoute(cCycle);
}",
