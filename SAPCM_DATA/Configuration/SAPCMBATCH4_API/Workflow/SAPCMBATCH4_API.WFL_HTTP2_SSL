              "sourceCode": "import ultra.http;
import ultra.SAPCMBATCH4_API.UFL_MasterDataCreation;
consume {
    debug(input);
    
    //decoding bytearray received from client
    bytearray requestBody = input.body;
    string jsonString = baToStr(requestBody);
    
    //udr to store decoded data
    Person person = udrCreate(Person);
    jsonDecodeUdr(jsonString,person);
    debug(\"Decoded data:\"+person);
    
    //udr to send response to client
    PersonResponse perRes = udrCreate(PersonResponse);
    perRes.message = \"Hello \"+person.name;
    
    bytearray baResp;
    string jsonResp = jsonEncodeUdr (perRes);
    strToBA(baResp, jsonResp);
    Response res = udrCreate(Response);   
    
      
    res.body = baResp;//bytearray response
    res.statusCode = 200;
    input.response = res;
    udrRoute(input);
}
