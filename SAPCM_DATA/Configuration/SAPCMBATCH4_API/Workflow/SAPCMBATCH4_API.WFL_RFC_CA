        "Name": "Analysis_1",
        "ID": -540133671,
        "Classname": "com.digitalroute.wfc.analysis.AnalysisRealtimeInsp",
        "Configuration": [
          {
            "Type": 1,
            "Classname": "com.digitalroute.wfc.analysis.AnalysisRealtimeInsp",
            "Data": {
              "sourceCode": "import ultra.SAP_RFC.SAPCMBATCH4_COMMON.PRF_RFC-CA_CREATE;
import ultra.SAP_RFC.SAPCMBATCH4_COMMON.PRF_RFC-CA_CREATE.subUdr;

string businessPartner = \"1000625\";
string bpInternal      = \"0001000625\";   // same partner, 10 digits with leading zeros
string accountCategory = \"CE\";
string accountName     = \"1000625\";
string applArea        = \"S\";
string validFrom       = \"11/08/2026\";

boolean testRun = false;

consume {
    debug(input);

    if (instanceOf(input, PulseUDR)) {

        BAPI_CTRACCONTRACTACCOUNT_CR1_UDR req =
            udrCreate(BAPI_CTRACCONTRACTACCOUNT_CR1_UDR);

        req.isTwoPhaseCommit = true;

        // IMPORT PARAMETERS
        importParams_BAPI_CTRACCONTRACTACCOUNT_CR1 imp =
            udrCreate(importParams_BAPI_CTRACCONTRACTACCOUNT_CR1);

        BAPIFKKVKCI createInfo = udrCreate(BAPIFKKVKCI);
        createInfo.BUSPARTNER  = businessPartner;
        createInfo.ACCT_CAT    = accountCategory;
        createInfo.APPL_AREA   = applArea;
        createInfo.CONT_ACCT   = \"\";
        createInfo.LEGACY_ACCT = \"\";
        imp.CTRACCREATEINFO = createInfo;

        BAPIFKKVKI detail = udrCreate(BAPIFKKVKI);
        detail.ACCT_NAME = accountName;
        imp.CTRACDETAIL = detail;

        imp.VALIDFROM = validFrom;
        imp.TESTRUN   = testRun ? \"X\" : \"\";

        req.importParams = imp;

        // TABLE PARAMETERS
        tableParams_BAPI_CTRACCONTRACTACCOUNT_CR1 tbl =
            udrCreate(tableParams_BAPI_CTRACCONTRACTACCOUNT_CR1);

        list<BAPIFKKVKPI1> partnerDetail = listCreate(BAPIFKKVKPI1);

        BAPIFKKVKPI1 pd = udrCreate(BAPIFKKVKPI1);
        pd.BUSPARTNER         = bpInternal;   // must match the key in EXTENSIONIN
        pd.COMP_CODE          = \"VJ01\";
        pd.STANDARD_COMP_CODE = \"VJC1\";
        pd.TOLER_GROUP        = \"S001\";
        pd.ACCT_RELAT         = \"VJ\";
        listAdd(partnerDetail, pd);

        tbl.CTRACPARTNERDETAIL = partnerDetail;
        req.tableParams = tbl;

        // EXTENSION: Account Determination ID + Payment Terms
        int N = 0;   // total length of the includes between BUSPARTNER and KOFIZ_SC

        string v1 = padRight(bpInternal, 10)   // BUSPARTNER (same key as the partner row)
                  + padRight(\"\", N)            // includes
                  + padRight(\"02\", 2)          // KOFIZ_SC    Account Determination ID
                  + padRight(\"0001\", 4)        // ZAHLKOND_SC Payment Terms
                  + padRight(\"\", 4)            // GSBER_SC    Business Area (empty)
                  + padRight(\"\", 4);           // KTOKL_SC    Account Class (empty)

        list<BAPIPAREX> ext = listCreate(BAPIPAREX);
        BAPIPAREX e = udrCreate(BAPIPAREX);
        e.STRUCTURE  = \"BAPI_TE_FKKVKPI\";
        e.VALUEPART1 = v1;
        listAdd(ext, e);
        tbl.EXTENSIONIN = ext;

        debug(req);

        udrRoute(req);
    }
}

// helper: pad a string to a fixed length with spaces
string padRight(string s, int len) {
    while (strLength(s) < len) { s = s + \" \"; }
    return s;
}",
