          {
            "Type": 1,
            "Classname": "com.digitalroute.wfc.analysis.AnalysisRealtimeInsp",
            "Data": {
              "sourceCode": "import ultra.http;
import ultra.SAPCMBATCH4_API.UFL_MasterDataCreation;
import apl.SAPCMBATCH4_API.APL_FUNCTIONS;
consume {
    RequestCycle rc = (RequestCycle)input;//token resp
    RequestCycle og = (RequestCycle)rc.context;//original client req
    debug(\"Token resp:\"+rc);
    if(rc.response.statusCode == 200){
        debug(\"Token:\"+rc);
        
        BP_Raw bpRaw  = (BP_Raw)og.context;
        
        BP_Root bp = buildBusinessPartner(
            bpRaw.firstName,              // firstName
            bpRaw.lastName,         // lastName
            bpRaw.firstName,         // searchTerm1
            bpRaw.country,              // country
            bpRaw.region,              // region
            bpRaw.cityName,       // cityName
            bpRaw.postalCode,           // postalCode
            bpRaw.streetName,    // streetName
            bpRaw.houseNumber             // houseNumber
        );
        // 1. Extract CSRF token
        string token = listGet(mapGet(rc.response.headers, \"x-csrf-token\"), 0);
    
        // 2. Extract raw session cookies directly from response headers
        list<string> cookieHeader = getCookieHeader(rc);
        
        // 3. Encode the BP payload
        string strBp = jsonEncodeUdr(bp);
        bytearray baBp;
        strToBA(baBp, strBp);
    
        // 4. Build POST request with the CSRF token and Cookie header
        RequestCycle reqBp = buildBpCreate(token, baBp, cookieHeader);
        reqBp.context = og;
        udrRoute(reqBp,\"bpReq\");
    }else{
        
        ResponseBp resp = createResp(\"Token request failed\",\"failed\",\"\");
        og.response = udrCreate(Response);
        string res = jsonEncodeUdr(resp);
        bytearray ba ;
        strToBA(ba,res);
        og.response.body = ba;
        udrRoute(og,\"toResp\");
    }
}",
