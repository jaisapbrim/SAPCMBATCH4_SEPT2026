              "sourceCode": "import ultra.http;
import ultra.SAPCMBATCH4_API.UFL_MasterDataCreation;
import apl.SAPCMBATCH4_API.APL_FUNCTIONS;
consume {
    
    RequestCycle rc = (RequestCycle)input;
    RequestCycle og = (RequestCycle)rc.context;
    try{
    debug(\"BP resp:\"+rc);
    if(rc.response.statusCode == 201){
        bytearray ba = (bytearray)rc.response.body;
        string jsonString = baToStr(ba);
        
        BP bp = udrCreate(BP);
        any obj = jsonParse(jsonString);
        bp.BusinessPartner = (string)obj.d.BusinessPartner;
        debug(\"Created bp:\"+bp);
        ResponseBp resp = createResp(\"BP created successfully\",\"suceess\",bp.BusinessPartner);
        og.response = udrCreate(Response);
        string res = jsonEncodeUdr(resp);
        bytearray bA ;
        strToBA(bA,res);
        og.response.body = bA;
        udrRoute(og,\"toResp\");
    }else{
        ResponseBp resp = createResp(\"BP creation failed\",\"failed\",\"\");
        og.response = udrCreate(Response);
        string res = jsonEncodeUdr(resp);
        bytearray ba ;
        strToBA(ba,res);
        og.response.body = ba;
        udrRoute(og,\"toResp\");
       
    }
    }catch(ExceptionDetails e){
        debug(\"Exception :\"+e);
    }
}",
