  "Data": {
    "scheme": "openapi: 3.0.0
info:
  title: Simple Order API
  version: 1.0.0
paths:
  /orders:
    post:
      summary: Create a basic order
      operationId: createOrder
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/OrderReq'
      responses:
        '200':
          description: Order processed successfully
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OrderResp'

components:
  schemas:
    OrderReq:
      type: object
      required:
        - customerId
        - itemCode
        - quantity
      properties:
        customerId:
          type: string
          example: \"CUST-101\"
        itemCode:
          type: string
          example: \"ITEM-A5\"
        quantity:
          type: integer
          example: 2

    OrderResp:
      type: object
      required:
        - orderId
        - status
        - totalAmount
      properties:
        orderId:
          type: string
          example: \"ORD-9981\"
        status:
          type: string
          example: \"CONFIRMED\"
        totalAmount:
          type: number
          format: double
          example: 149.99",
