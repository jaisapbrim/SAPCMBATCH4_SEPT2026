            "Data": {
              "sourceCode": "import ultra.openapi.SAPCMBATCH4_IWF.PRF_OPEN_API_ORDER;
import ultra.http;
import ultra.SAPCMBATCH4_IWF.UFL_IWF;



consume {
    debug(input);
    //Payload received
    OrderReq orderReq = (OrderReq)input.openAPIUDR;
    debug(\"Payload:\"+orderReq);
    //vaidation
    boolean isValid = false;
    if(orderReq.customerId != null && orderReq.customerId != \"\"){
        //invalid record send to ECS
        isValid = true;
    }
    
    
    OrderResp orderRes = udrCreate(OrderResp);
    if(isValid){
        orderRes.orderId = (string)uuidCreateRandom();
        orderRes.status = \"CONFIRMED\";
        orderRes.totalAmount = orderReq.quantity * 10;
    }else{
        orderRes.orderId = \"INVALID CUSTOMER ID\";
        orderRes.status = \"FAILED\";
        orderRes.totalAmount = 0;
    }
     debug(\"Response:\"+orderRes);
    Response res = udrCreate(Response);    
    res.openAPIUDR = orderRes;
    res.statusCode = 200;
    input.response = res;
    udrRoute(input,\"res\");
   
    TxnSumm sum = udrCreate(TxnSumm);
    sum.req = (orderReq);
    sum.res = (orderRes);
    udrRoute(sum,\"toIwf\");
    
 
}",
