      {
        "Name": "Aggregation_1",
        "ID": 1271441448,
        "Classname": "com.digitalroute.wfc.aggregation.AggregationInsp",
        "Configuration": [
          {
            "Type": 1,
            "Classname": "com.digitalroute.wfc.aggregation.AggregationInsp",
            "Data": {
              "commitCount": 1,
              "commitTimeout": 1,
              "defaultTimeout": -1,
              "defragAfterNumberOfBatches": 1,
              "defragEachBatchTimeLimit": 5,
              "defragFileAgeLimit": 5,
              "defragFileAgeLimit_TimeUnit": "MINUTES",
              "defragTrigger": "None",
              "intervalTimeout": 1,
              "mainScript": "import ultra.SAPCMBATCH4_AGGREGATION.UFL_Aggregation;

sessionInit{
    Radius rad = (Radius)input;
    SessionIp sess = (SessionIp)session;
    
    sess.IPAddress = rad.framed_ip_address;
    sess.sessionID = rad.acct_session_id;
    sess.user = rad.user_name;
    sessionTimeout(session,-1);
    debug(\"Initialize: session:\"+session);
}
consume {
    //debug(\"consume: session:\"+session);
    debug(\"consume: udr:\"+input);
    if(instanceOf(input,Radius)){
        Radius rad = (Radius)input;
        if(rad.acct_status_type == \"1\"){
            //do nothing as start udr arrived and netflow will send data    
        }else{
            
                //remove and consume the session aggregated data as stop udr arrived
              OutputUDR finalUDR = udrCreate( OutputUDR ); 
              finalUDR.user = session.user; 
              finalUDR.IPAddress = (string)session.IPAddress; 
              finalUDR.downloadedBytes = session.downloadedBytes; 
              finalUDR.uploadedBytes = session.uploadedBytes; 
              if(finalUDR.uploadedBytes != 0 || finalUDR.downloadedBytes != 0){
                udrRoute( finalUDR );
              }
              debug(\"Remove session:\"+session);
              sessionRemove(session);   
        }
    }else if(instanceOf(input,Netflow)){
        Netflow netflow = (Netflow)input;
        //check if its download data or upload data
        if(session.IPAddress == netflow.source_ip){
            session.downloadedBytes = session.downloadedBytes + netflow.bytes_in_flow;    
        }else if(session.IPAddress == netflow.destination_ip){
            session.uploadedBytes = session.uploadedBytes + netflow.bytes_in_flow;    
        }else{
            //start udr for this netflow udr never came so do nothing.    
        }
    }
}
timeout{
      OutputUDR finalUDR = udrCreate( OutputUDR ); 
      finalUDR.user = session.user; 
      finalUDR.IPAddress = (string)session.IPAddress; 
      finalUDR.downloadedBytes = session.downloadedBytes; 
      finalUDR.uploadedBytes = session.uploadedBytes; 
      if(finalUDR.uploadedBytes != 0 || finalUDR.downloadedBytes != 0){
        udrRoute( finalUDR );
      }
      sessionRemove(session); 
      debug(\"Remove session timeout:\"+session);      
}",
