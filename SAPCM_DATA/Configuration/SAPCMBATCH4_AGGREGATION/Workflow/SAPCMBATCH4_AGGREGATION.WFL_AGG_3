              "defragTrigger": "None",
              "intervalTimeout": 1,
              "mainScript": "import ultra.SAPCMBATCH4_AGGREGATION.UFL_Aggregation;
sessionInit{
    //debug(\"session created for key:\"+input.subsId+\"_\"+input.service_type);
    //session.rec = input;
    sessionTimeout(session,-1);
    
}
consume {
    
    if(session.rec == null){
        //session init called and new session was created, initialize data
        session.rec = input;
    }else{
        //already the session was created by some other record(old session exist)
        //consolidate the current record with session previous data
        session.rec.consumption =  session.rec.consumption + input.consumption;
    }
}
timeout{
    //timeout called, remove the aggregated session data
    debug(\"timeout executed\");
    telcoUsage2 data = session.rec;
    udrRoute(data);
    sessionRemove(session);
}",
