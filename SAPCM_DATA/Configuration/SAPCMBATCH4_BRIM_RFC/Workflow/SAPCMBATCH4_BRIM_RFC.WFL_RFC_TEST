            "Data": {
              "sourceCode": "import ultra.SAP_RFC.SAPCMBATCH4_BRIM_RFC.PRF_RFC_TEST;
import ultra.SAP_RFC.SAPCMBATCH4_BRIM_RFC.PRF_RFC_TEST.subUdr;
consume {

    Z_CUSTOM_DATE_STRING_ECHO_UDR rfc = udrCreate(Z_CUSTOM_DATE_STRING_ECHO_UDR);
    importParams_Z_CUSTOM_DATE_STRING_ECHO imp = udrCreate(importParams_Z_CUSTOM_DATE_STRING_ECHO);
    imp.IV_DATE = dateCreateNow();
    imp.IV_STRING = \"HELLO FROM CM\";
    rfc.importParams = imp;
    
    debug(rfc);
    udrRoute(rfc);
    
}",
