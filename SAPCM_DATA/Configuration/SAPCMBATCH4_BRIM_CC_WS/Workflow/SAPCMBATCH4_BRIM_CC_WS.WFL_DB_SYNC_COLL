import ultra.ws.SAPCMBATCH4.PRFCCWSCATLOG.schema;
import ultra.ws.SAPCMBATCH4.PRFCCWSCATLOG.wsse;

WSCycle_mappingTableRowMaintain mtRowMaintain;
beginBatch{
    mtRowMaintain = buildMaintainRequest();    
}
consume {
    //debug(input);
    if(input.operation == \"N\"){
        //row maintain/create request
        MappingTableRow row = buildRow(input);
        listAdd(mtRowMaintain.param_mappingTableRowMaintainRequest.row,row);
    }
}
drain{
    debug(mtRowMaintain);
    wfb.ConsumeCycleUDR cCycle = udrCreate(wfb.ConsumeCycleUDR);
    cCycle.Data =  mtRowMaintain;
    udrRoute(mtRowMaintain);
}

// One column holding a string value (for LOCATION)
MappingTableColumn buildStringColumn(string colName, string val) {
    MappingTableColumn col = udrCreate(MappingTableColumn);
    col.name    = colName;
    col.string_ = val;
    return col;
}

// One column holding a numeric value (for AMOUNT)
MappingTableColumn buildNumberColumn(string colName, double val) {
    MappingTableColumn col = udrCreate(MappingTableColumn);
    col.name   = colName;
    col.number = val;
    return col;
}

// One row of EV_LOC_RATES: Identifier, LOCATION, Start Date, End Date, AMOUNT
MappingTableRow buildRow(mtEvLocRate ip) {
    MappingTableRow row = udrCreate(MappingTableRow);
    row.id    = ip.id;
    row.start = ip.stDate;
    row.end   = ip.edDate;

    list<MappingTableColumn> cols = listCreate(MappingTableColumn);
    listAdd(cols, buildStringColumn(\"LOCATION\", ip.location));
    listAdd(cols, buildNumberColumn(\"AMOUNT\",   ip.amount));
    row.column = cols;
    return row;
}

// Main function: builds the full request for EV_LOC_RATES
WSCycle_mappingTableRowMaintain buildMaintainRequest() {

    WSCycle_mappingTableRowMaintain ws = udrCreate(WSCycle_mappingTableRowMaintain);
    
    MaintainMappingTableRowRequest req = udrCreate(MaintainMappingTableRowRequest);
    req.mappingTableId = \"EV_LOC_RATES\";

    list<MappingTableRow> rows = listCreate(MappingTableRow);
    req.row = rows;

    ws.param_mappingTableRowMaintainRequest = req;

    // WS-Security header
    ws.param_Security = udrCreate(Security);
    ws.param_Security.UsernameToken = udrCreate(Security$UsernameToken);
    ws.param_Security.UsernameToken.Username = \"CC_CM_USER1\";
    ws.param_Security.UsernameToken.Password = \"Sapcm@1947\";
    

    return ws;
}",
