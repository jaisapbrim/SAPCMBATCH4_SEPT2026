            "Data": {
              "sourceCode": "import ultra.SAPCMBATCH4_APL-FUNDAMENTALS_APL-FUNC.UFDL_EV;

consume {
    EvOut evOut = covertToEvOut(input);
    debug(evOut);
    udrRoute(evOut);
}
EvOut covertToEvOut(EvConsTI ev){
    EvOut evOut = udrCreate(EvOut);
    evOut.sessionId  = ev.sessionId;
    evOut.customerId  = strToUpper(strTrim(ev.customerId));
    evOut.stationRegion  = strSubstring(ev.sessionId,3,6);
    evOut.chargerType  = strToUpper(strTrim(ev.chargerType));
    evOut.energyKWh  = ev.dEnergyKWh;
    
    if(evOut.chargerType == \"DC-FAST\"){
        evOut.tariffPerKWh  = 20;
    }else if(evOut.chargerType == \"AC-SLOW\"){
        evOut.tariffPerKWh  = 12;
    }
    evOut.chargingCost  = evOut.tariffPerKWh * evOut.energyKWh;
    string st,ed;
    dateToString(st,ev.dtStartTime,\"yyyy MMM dd hh:mm:ss\");
    evOut.startTime  = st;//yyyy MMM dd hh:mm:ss a
    
    dateToString(ed,ev.dtEndTime,\"yyyy MMM dd hh:mm:ss a\");
    evOut.endTime  = ed;
    
    evOut.durationMinutes  = dateDiff(ev.dtEndTime,ev.dtStartTime)/60000;
    evOut.status  = ev.status;
    evOut.sourceRegion  = strSubstring(ev.source,0,3);
    evOut.chargerPowerKW  = ev.dEnergyKWh;
    evOut.processedAt  = (string)dateCreateNow();
    
    return evOut;
}",
