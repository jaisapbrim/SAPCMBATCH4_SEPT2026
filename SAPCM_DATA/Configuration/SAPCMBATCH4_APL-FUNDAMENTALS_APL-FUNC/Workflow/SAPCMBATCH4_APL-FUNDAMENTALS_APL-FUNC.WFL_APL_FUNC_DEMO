            "Data": {
              "sourceCode": "import ultra.SAPCMBATCH4_APL-FUNDAMENTALS_APL-FUNC.UFDL_EV;
consume {
    
    boolean validity = isValidRec(input);
    if(validity == true){
        //valid record   
        debug(input);
        udrRoute(input,\"toFilteration\") ;
    }else{
        //invalid record, rejected    
        udrRoute(input,\"toReject\");
    }
}

boolean isValidRec(EvConsTI ev){
    boolean isValid = true;//assuming rec is valid
    
    //validate sessionId
    ev.sessionId = strToUpper(strTrim(ev.sessionId));
    boolean isMatches = strREMatches(ev.sessionId,\"^EV-[A-Z]{3}-[0-9]{4}\");
    if(isMatches == false){
        isValid = false;    
    }
    //validate energyKWh
    double dEnergyKWh;
    boolean isValidNum = strToDouble(dEnergyKWh,ev.energyKWh);
    if(isValidNum == false){
        isValid = false;    
    }
    ev.dEnergyKWh = dEnergyKWh;//assign in internal
    
    //validate start and end time
    date dtSt;
    boolean isValidSt = strToDate(dtSt,ev.startTime,\"yyyy-MM-dd HH:mm:ss\");
    if(isValidSt == false){
        isValid = false;
    }
    
    date dtEd;
    boolean isValidEd = strToDate(dtEd,ev.endTime,\"yyyy-MM-dd HH:mm:ss\");
    if(isValidEd == false){
        isValid = false;
    }
    ev.dtStartTime = dtSt;
    ev.dtEndTime = dtEd;
    //validate chargerPowerKW
    double dChargerPowerKW;
    boolean isValidNumP = strToDouble(dChargerPowerKW,ev.chargerPowerKW);
    if(isValidNumP == false){
        isValid = false;    
    }
    ev.dChargerPowerKW = dChargerPowerKW;//assign in internal
    return isValid;
}",
