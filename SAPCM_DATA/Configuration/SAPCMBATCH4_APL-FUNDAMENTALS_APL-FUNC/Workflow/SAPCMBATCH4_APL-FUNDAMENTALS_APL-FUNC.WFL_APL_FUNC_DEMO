            "Data": {
              "sourceCode": "import ultra.SAPCMBATCH4_APL-FUNDAMENTALS_APL-FUNC.UFDL_EV;

consume {
    
    
    boolean filtered = isEvFiltered(input);
    
    if(filtered == true){
        
        udrRoute(input,\"toFilter\");
    }else{
        //debug(input);
        udrRoute(input,\"toEnrich\") ;   
    }
}
boolean isEvFiltered(EvConsTI ev){
   boolean isFil = false;
   
   long diff = dateDiff(ev.dtStartTime,ev.dtEndTime);
   if(diff > 0){
       isFil = true;//start datetime is greater then enddatetime
   }
   ev.status = strToUpper(strTrim(ev.status));
   
   if(ev.status != \"COMPLETED\"){
       isFil = true;      
   }    
   
   if(ev.dEnergyKWh <= 0){
       isFil = true; 
   }                
   return isFil;                                              
}",
