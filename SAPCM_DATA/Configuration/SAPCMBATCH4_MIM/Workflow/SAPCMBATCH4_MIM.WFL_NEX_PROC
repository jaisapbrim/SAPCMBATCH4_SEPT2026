          {
            "Type": 1,
            "Classname": "com.digitalroute.wfc.analysis.StuffyMapperInsp",
            "Data": {
              "sourceCode": "import apl.SAPCMBATCH4_MIM.APL_FUNC;

//creation
mimPublish(global ,\"TOTAL_REC\",int);
initialize{
    string wfName = (string)mimGet(\"Workflow\",\"Workflow Name\");
    debug(wfName); 
}
beginBatch{
    total = 0;    
}
consume {
    total++;
    //debug(input);
    /*if(instanceOf(input,NexRu)){
        NexRu nex = (NexRu)input;
        if(strREContains(nex.Sub_Category,\"SERVICES\")){
            udrRoute(nex,\"toCharge\");   
        }else{
            udrRoute(nex,\"toNonCharge\"); 
        }
    }*/
    
    if(strREContains(input.Sub_Category,\"SERVICES\")){
        udrRoute(input,\"toCharge\");   
    }else{
        udrRoute(input,\"toNonCharge\"); 
    }
}
drain{
    debug(\"Total rec:\"+total); 
    //assignment
    mimSet(\"TOTAL_REC\",total);   
}",
              "udrTypes": [
                {
                  "TypeName": "SAPCMBATCH4_MIM.UFL_NEX.NexRu",
