              "sourceCode": "import apl.SAPCMBATCH4_MIM.APL_FUNC;
beginBatch{
    nonchargeCnt = 0;   
}
consume {
    //needs to be charged
    nonchargeCnt++;
    udrRoute(input);
}
drain{
    total = (int)mimGet(\"seg\",\"TOTAL_REC\");
    debug(\"Total:\"+total+\" Non Charge rec:\"+nonchargeCnt);    
}",
