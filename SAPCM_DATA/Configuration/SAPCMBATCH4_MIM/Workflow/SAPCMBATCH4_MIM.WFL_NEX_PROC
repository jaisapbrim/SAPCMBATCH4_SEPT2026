            "Type": 1,
            "Classname": "com.digitalroute.wfc.analysis.StuffyMapperInsp",
            "Data": {
              "sourceCode": "import apl.SAPCMBATCH4_MIM.APL_FUNC;
beginBatch{
    chargeCnt = 0; 
      
}
consume {
    //needs to be charged
    chargeCnt++;
    udrRoute(input);
}
drain{
    //access
    total = (int)mimGet(\"seg\",\"TOTAL_REC\");
    debug(\"Total rec:\"+total+ \" Charge rec:\"+chargeCnt);    
}",
