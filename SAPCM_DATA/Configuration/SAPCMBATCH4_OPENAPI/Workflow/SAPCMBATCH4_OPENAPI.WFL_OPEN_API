        "Name": "Analysis_1",
        "ID": -540133671,
        "Classname": "com.digitalroute.wfc.analysis.AnalysisRealtimeInsp",
        "Configuration": [
          {
            "Type": 1,
            "Classname": "com.digitalroute.wfc.analysis.AnalysisRealtimeInsp",
            "Data": {
              "sourceCode": "import ultra.openapi.SAPCMBATCH4_OPENAPI.PRF_OPEN_API_ORD_V1;
consume {
    //debug(input);
    debug(\"Input payload:\"+input.openAPIUDR);
    OrderResp ordResp = udrCreate(OrderResp);
    ordResp.orderId = (string)uuidCreateRandom();
    ordResp.status = \"CONFIRMED\";
    ordResp.totalAmount = 100;
    
    input.response = udrCreate(Response);
    input.response.openAPIUDR = ordResp;
    input.response.statusCode = 200;
    
    udrRoute(input,\"resp\");
    udrRoute(input.openAPIUDR,\"iwf\");
    
}",
              "udrTypes": [
                {
                  "typeName": "http.RequestCycle",
                  "$Version": 1.0
