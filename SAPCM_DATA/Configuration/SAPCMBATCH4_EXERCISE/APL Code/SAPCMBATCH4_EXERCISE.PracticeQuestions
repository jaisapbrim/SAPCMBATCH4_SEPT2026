Downstream 2: TB_PROCESSED_RECORDS(FILENAME,CREATED_ON,REC_TYPE,SERVER,CUST,CPU_H,RAM_H,STORAGE_H,ENV,PERIOD)

Processing logic:
1. Decode the data
2. Insert the records in TB_PROCESSED_RECORDS only if the total CPU_vCPU_Hours is above 300.
3. Filter the records which are not part of Environment [PRD,TST]
4. Insert the records in TB_PROCESSING_SUMMARY for each file. Mark STATUS as 'Eligible' if the CPU_vCPU_Hours is above 300 or NotEligible

CREATE TABLE TB_PROCESSING_SUMMARY (
    FILENAME    VARCHAR(255) NOT NULL,
    CREATED_ON  TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    REC_COUNT   BIGINT NOT NULL DEFAULT 0,
    STATUS      VARCHAR(30) NOT NULL
);

INSERT INTO public.tb_processing_summary
(filename, rec_count, status)
VALUES($(Disk_1.Source Filename), $(UDR.recCount), $(UDR.status));

INSERT INTO public.tb_processed_records
(filename, rec_type, server, cust, cpu_h, ram_h, storage_h, env, period)
VALUES($(Disk_1.Source Filename), $(UDR.Record_Type),  $(UDR.Server_ID), $(UDR.Customer_ID), $(UDR.CPU_vCPU_Hours), $(UDR.RAM_GB_Hours),  $(UDR.Storage_GB_Hours),  $(UDR.Environment), $(UDR.Period));

CREATE TABLE TB_PROCESSED_RECORDS (
