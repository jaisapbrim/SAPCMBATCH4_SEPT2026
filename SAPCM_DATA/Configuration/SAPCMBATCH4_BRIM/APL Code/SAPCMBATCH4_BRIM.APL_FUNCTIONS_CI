string setCIIntKey(string wflName) {

   date dateNow = dateCreateNow();
   string dateNowStr;
   dateToString(dateNowStr, dateNow, CI_KEY_DATE_FORMAT);
   string key = CI_KEY_PREFIX + dateNowStr + \"_\" + wflName; 
   return key; 
}  
 
string isCITValid(_1FC_1BT18_API out){
    string field = null;
    
    if(isEmpty(out.VKONT)){
        field = \"VKONT\";
    }else if(isEmpty(out.GPART)){
        field = \"GPART\";
    }else if(isEmpty(out.VTREF)){
        field = \"VTREF\";
    }
    
    return field;
}


Forw_Realtime_Audit_Int createForwRTAuditIntUdr(string workflowName, string outputKey, 
    date auditStartTime, date auditEndTime, string destinationSystem,
    long inputUdrCount, long sentSuccessUdrCount, long sentFailedUdrCount) {
 
    Forw_Realtime_Audit_Int in = udrCreate(Forw_Realtime_Audit_Int);
    in.workflowName = workflowName;
    in.outputKey = outputKey;
    in.auditStartTime = auditStartTime;
    in.auditEndTime = auditEndTime;
    in.auditDuration = dateDiff(auditEndTime, auditStartTime);
    in.destinationSystem = destinationSystem;
    in.inputUdrCount = inputUdrCount;
    in.sentSuccessUdrCount = sentSuccessUdrCount;
    in.sentFailedUdrCount = sentFailedUdrCount;   
    return in;
}
Forw_Realtime_Audit_Int setToCIAudit(CI_Int in, string workflowName, boolean sentSuccess) {
    long inputUdrCount = 0;
    long sentSuccessUdrCount = 0;
    long sentFailedUdrCount = 0;
    
    inputUdrCount = in.inputUdrCount;
    
    if (sentSuccess) {
        sentSuccessUdrCount = in.inputUdrCount;    
    } else {
        sentFailedUdrCount = in.inputUdrCount;
    }
    Forw_Realtime_Audit_Int out = createForwRTAuditIntUdr(workflowName, in.key, 
        in.sentDate, dateCreateNow(), ADT_TO_CI,
        inputUdrCount, sentSuccessUdrCount, sentFailedUdrCount);
    return out;
