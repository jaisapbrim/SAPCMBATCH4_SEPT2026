table tbVt = tableCreate(PRF_DB,SELECT_DFKK_VT_I);


_1FC_1BT18_API setBT18Udr(EV_Cons ip){
    debug(ip);
    date citDateFrom = dateCreateCopy(ip.dtChSt);
    dateSetDay(citDateFrom,1);
    
    date citDateTo = dateCreateCopy(ip.dtChEd);
    dateAddMonths(citDateTo,1);
    dateAddDays(citDateTo,-1);
    
    debug(\"Dates:\"+citDateFrom+\" \"+citDateTo);
    _1FC_1BT18_API out  = udrCreate(_1FC_1BT18_API);
    
    date dateNow = dateCreateNow();
    out.ACCESS_SERVICEID = CIT_ACCESS_SERVICEID_EVBILL;
    out.SRCTATYPE = CIT_SRCTATYPE_01;
    out.CITDATE = dateNow;
    out.CITDATE_FROM = citDateFrom;
    out.CITDATE_TO = citDateTo;
    out.CITTIME = dateNow;
    out.CITTIME_FROM = citDateFrom;
    out.CITTIME_TO = citDateTo;
    string CONSUMDATE;
    date consumDate = dateCreateCopy(ip.dtChSt);//tbd
    if (dateToString(CONSUMDATE, consumDate, CIT_CONSUMDATE_DATE_FORMAT))
        out.CONSUMDATE = CONSUMDATE;
    out.CITID = (string)uuidCreateRandom();;
    out.CITIDTYPE = \"ZEVC\";
    //out.CITTYPE = \"01\";    
    strToDouble(out.CIT_QUANTITY ,ip.TotalChargingHrs);
    out.CIT_QTY_UNIT = \"PC\";   
    out.CIT_CURR = \"USD\";
    out.ACCESS_USERID = ip.VehicleId;
    out.ZZCHG_CHG_ED = ip.ChargingEndTime;
    out.ZZCHG_CHG_ST = ip.ChargingStartTime;
    strToFloat(out.ZZCHG_HRS,ip.TotalChargingHrs);
    out.ZZCHG_LOC = ip.ChargingLocation;
    out.ZZVEHICLE_ID = ip.VehicleId;
    setMasterDataEv(out,ip);
    return out;     
}

void setMasterDataEv(_1FC_1BT18_API out,EV_Cons ip){
    debug(ip);
    table tbFil = tableLookup(tbMasterDataEv,\"TR_OBJ_ID\",\"=\",ip.VehicleId);  
    if(tbFil != null && tableRowCount(tbFil)>0){
        out.VTREF = (string)tableGet(tbFil,0,\"CI_CONTRACT_ID\");
        table tbVtFil = tableLookup(tbVt,\"VTKEY\",\"=\",out.VTREF);
        
        if(tbVtFil != null && tableRowCount(tbVtFil)>0){            
            out.VKONT = (string)tableGet(tbVtFil,0,\"VKONT\");
            strToLong(out.VTPOS,(string)tableGet(tbVtFil,0,\"VTPOS\"));
            out.GPART = (string)tableGet(tbVtFil,0,\"CB_BILLTO\");
        }else{
            cancelBatch(\"Unable to derive BP/CA master data for data:\"+\"\\n\"+tbVtFil+\"\\n\"+out);
    
        }
        
    }else{
        cancelBatch(\"Unable to derive provider contract master data for data:\"+\"\\n\"+tbFil+\"\\n\"+out);
    }
}

