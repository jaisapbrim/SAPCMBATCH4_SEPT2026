            "Data": {
              "sourceCode": "import ultra.SAP_RFC.SAPCMBATCH4_COMMON.PRF_RFC_CIT_CREATE;
import ultra.SAP_RFC.SAPCMBATCH4_COMMON.PRF_RFC_CIT_CREATE.subUdr;
import ultra.SAPCMBATCH4_BRIM.UFL_RIDE;
import apl.SAPCMBATCH4_BRIM.APL_FUNCTIONS;
import apl.SAPCMBATCH4_BRIM.APL_FUNCTIONS_CI;

string ciKey,filename;
_1FC_BT18_CIT_CREATE_API_UDR ciUdr;
boolean route = true;
initialize {
    ciKey = setCIIntKey(WORKFLOW_NAME);
    ciUdr = createBt18CitUdr();
}
beginBatch{
    filename = (string)mimGet(\"FromColl\", \"Source Filename\");
}
consume {
    if(instanceOf(input,EV_Cons)){
       EV_Cons ip = (EV_Cons)input;
       //ip.VehicleId = \"VEH_101\";
       _1FC_1BT18_API bt18Udr = setBT18Udr(ip);
       
       string fieldName = isCITValid(bt18Udr);
       if(!isEmpty(fieldName)){
            string msg = \"EVT_MSG_CIT_VALIDATION_FAILED:\" + fieldName;
            //dispatchMessage(msg , EVT_CAT_CIT_VALIDATION_FAILED);
            debug(msg + \"\\n\" + bt18Udr);
            cancelBatch(msg + \"\\n\" + bt18Udr);
       }else{
           listAdd(ciUdr.tableParams.IT_CIT, bt18Udr);
       }
    }
}
drain{
    if(listSize(ciUdr.tableParams.IT_CIT) > 0){
        CI_Int out = createCIIntUdr( ciKey , \"EV_CI_ERR\", false, ciUdr);
        debug(out);
        if(route){
            udrRoute(out, \"toCIEnc\");
        }
    }
}",
