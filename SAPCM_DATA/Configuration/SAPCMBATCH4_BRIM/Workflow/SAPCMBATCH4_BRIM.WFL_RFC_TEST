        "Name": "Analysis_1",
        "ID": -540133671,
        "Classname": "com.digitalroute.wfc.analysis.AnalysisRealtimeInsp",
        "Configuration": [
          {
            "Type": 1,
            "Classname": "com.digitalroute.wfc.analysis.AnalysisRealtimeInsp",
            "Data": {
              "sourceCode": "import ultra.SAP_RFC.SAPCMBATCH4_COMMON.PRF_RFC_CIT_CREATE;
import ultra.SAP_RFC.SAPCMBATCH4_COMMON.PRF_RFC_CIT_CREATE.subUdr;

consume {
    try {
        if (instanceOf(input, PulseUDR)) {
            Z_CUSTOM_DATE_STRING_ECHO_UDR rfc = udrCreate(Z_CUSTOM_DATE_STRING_ECHO_UDR);
            rfc.importParams = udrCreate(importParams_Z_CUSTOM_DATE_STRING_ECHO);
            
            // 1. Get the current date numbers
           //4. Force assign the raw memory byte array directly into the date parameter field
            // This bypasses the buggy com.digitalroute.picomega.types.Date marshaling logic
            strToDate(rfc.importParams.IV_DATE,\"20261103\",\"yyyyMMdd\");
            
            rfc.importParams.IV_STRING = \"SAPCM TEXT MSG\"; 
            
            debug(rfc);
            udrRoute(rfc);
        } else {
            debug(\"response:\" + input);
        }
    } catch (ExceptionDetails e) {
        debug(e);   
    }
}",
              "udrTypes": [
                {
                  "typeName": "SAP_RFC.SAPCMBATCH4_COMMON.PRF_RFC_CIT_CREATE._1FC_BT18_CIT_CREATE_API_UDR",
                  "$Version": 1.0
