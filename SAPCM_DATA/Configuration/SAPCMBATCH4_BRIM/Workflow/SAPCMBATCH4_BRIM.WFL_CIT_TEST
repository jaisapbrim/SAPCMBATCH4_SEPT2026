        "Name": "Analysis_1",
        "ID": -540133671,
        "Classname": "com.digitalroute.wfc.analysis.AnalysisRealtimeInsp",
        "Configuration": [
          {
            "Type": 1,
            "Classname": "com.digitalroute.wfc.analysis.AnalysisRealtimeInsp",
            "Data": {
              "sourceCode": "import ultra.SAP_RFC.SAPCMBATCH4_COMMON.PRF_RFC_CIT_CREATE;
import ultra.SAP_RFC.SAPCMBATCH4_COMMON.PRF_RFC_CIT_CREATE.subUdr;
consume {
    if (instanceOf(input, PulseUDR)) {
        _1FC_BT18_CIT_CREATE_API_UDR rfc = udrCreate(_1FC_BT18_CIT_CREATE_API_UDR);
        rfc.importParams = udrCreate(importParams__1FC_BT18_CIT_CREATE_API);
        rfc.importParams.I_UNRATED = \"X\";
        rfc.importParams.I_MANDT = \"100\";
        rfc.importParams.I_FIRST_CALL = \"X\";
        rfc.importParams.I_LAST_CALL = \"X\";
        rfc.importParams.I_MAX_PROBCL = \"2\";

        rfc.tableParams = udrCreate(tableParams__1FC_BT18_CIT_CREATE_API);
        rfc.tableParams.ET_CIT0_RETURN = listCreate(_1FC_0BT180);
        rfc.tableParams.ET_CIT2_RETURN = listCreate(_1FC_0BT182);
        rfc.tableParams.ET_CIT4_RETURN = listCreate(_1FC_0BT18400);
        rfc.tableParams.ET_MESSAGES = listCreate(FKKBIX_API_MSG);
        rfc.isTwoPhaseCommit = false;
        rfc.tableParams.IT_CIT = listCreate(_1FC_1BT18_API);

        _1FC_1BT18_API bt18 = udrCreate(_1FC_1BT18_API);
        listAdd(rfc.tableParams.IT_CIT, bt18);

        date dt = dateCreateNow();

        // validity period: from today to the end of the month
        date citFrom = dateCreateNow();
        date citTo = dateCreateNow();
        dateSetDay(citTo, 1);
        dateAddMonths(citTo, 1);
        dateAddDays(citTo, -1);

        bt18.ACCESS_USERID = \"\";
        bt18.CIT_CURR = \"USD\";
        bt18.CIT_QUANTITY = 2;

        // date fields
        bt18.CITDATE = dt;
        bt18.CITTIME = dateCreateNow();
        bt18.CITDATE_FROM = citFrom;
        bt18.CITDATE_TO = citTo;

        // time fields
        date tFrom;
        strToDate(tFrom,\"202611\",\"HHmmss\");
        dateSetTime(tFrom, 0, 0, 0);
        date tTo = dateCreateCopy(tFrom);
        dateSetTime(tTo, 23, 59, 59);
        
        bt18.CITTIME_FROM = tFrom;;
        bt18.CITTIME_TO   = tTo;;

        // 32 characters, the length SAP stores
        bt18.ACCESS_SERVICEID = \"EV_BILL\";
        bt18.SRCTATYPE = \"01\";
        bt18.CITID = (string)randomLong();//uuidCreateRandom();
        bt18.CITIDTYPE = \"ZEVC\";
        bt18.CITTYPE = \"01\";
        dateToString(bt18.CONSUMDATE, dateCreateNow());
        bt18.GPART = \"1007112\";
        bt18.VKONT = \"200000000102\";
        bt18.VTPOS = 0;
        bt18.VTREF = \"00000000000700000190\";
        bt18.ZZCHG_CHG_ED = \"01/11/2026 12:10:10\";
        bt18.ZZCHG_CHG_ST = \"01/11/2026 02:10:10\";
        bt18.ZZCHG_HRS = 2;
        bt18.ZZCHG_LOC = \"LOC_CHICAGO_LOOP_PLAZA\";
        bt18.ZZVEHICLE_ID = \"VEH_101\";
        bt18.ACCESS_USERID = \"VEH_101\";
        bt18.CIT_QTY_UNIT = \"PC\";
        bt18.ZZCHG_HRS = 2.15;
        
        debug(\"input:\" + rfc);
        udrRoute(rfc);
    } else {
        debug(\"response:\" + input);
    }
}",
