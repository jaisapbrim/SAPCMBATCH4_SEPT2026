            "Classname": "com.digitalroute.wfc.analysis.AnalysisRealtimeInsp",
            "Data": {
              "sourceCode": "import apl.SAPCMBATCH4_BRIM.APL_FUNCTIONS_CI;
string wflName;
initialize {
    wflName = (string) mimGet(\"Workflow\", \"Workflow Name\");    
}
 
consume {
    if (instanceOf(input, CI_Int)) {
        //Sent data to CI for CIT creation
        CI_Int req = (CI_Int) input;
        req.sentDate = dateCreateNow();
        debug(\"Tx req:\" + req);
        CI_Int reqClone = udrClone(req);
        req.CiUdr.context = reqClone;
        udrRoute(req.CiUdr, \"toCI\");    
        
    } else if (instanceOf(input, NewFileUDR)) {
        NewFileUDR  nwu = (NewFileUDR) input;
        debug(\"NewFileUDR  nwu:\" + nwu);          
    } else if (instanceOf(input, RfcErrorUDR)) {
        RfcErrorUDR rfcErrorUdr = (RfcErrorUDR) input;
        debug(\"rfcErrorUdr:\" + rfcErrorUdr);
        //send error data to ECS
        _1FC_BT18_CIT_CREATE_API_UDR ciUdr = (_1FC_BT18_CIT_CREATE_API_UDR )rfcErrorUdr.inputUDR;
        CI_Int oriReq = (CI_Int)ciUdr.context;
        oriReq.rfcErrorMessage = rfcErrorUdr.errorMessage;
        udrRoute(oriReq, \"toECSEncoder\");
        
        //send for auditing
        Forw_Realtime_Audit_Int aud = setToCIAudit(oriReq, wflName, false);
        udrRoute(aud, \"toAuditEncoder\");       
    } else if (instanceOf(input, _1FC_BT18_CIT_CREATE_API_UDR)) {
        _1FC_BT18_CIT_CREATE_API_UDR resp = (_1FC_BT18_CIT_CREATE_API_UDR) input;
        CI_Int oriReq = (CI_Int) resp.context;
        debug(\"Rx resp:\" + resp);   
        
        boolean isSuccess = true;
        if(resp.tableParams.ET_MESSAGES != null && listSize(resp.tableParams.ET_MESSAGES)>0){
            isSuccess = checkCitStatus(resp);
        }
        if(!isSuccess){
            udrRoute(oriReq, \"toECSEncoder\");
        }
        Forw_Realtime_Audit_Int aud = setToCIAudit(oriReq, wflName, isSuccess);
        udrRoute(aud, \"toAuditEncoder\");
    } else {
        debug(\"unknown\");
    }    
}",
