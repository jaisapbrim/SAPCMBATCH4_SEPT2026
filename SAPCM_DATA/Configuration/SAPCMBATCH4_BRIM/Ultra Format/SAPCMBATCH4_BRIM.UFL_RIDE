\tstring outputKey;
\tdate auditStartTime;
\tdate auditEndTime;
\tlong auditDuration;
\tstring destinationSystem;
\tlong inputUdrCount;
\tlong sentSuccessUdrCount;
\tlong sentFailedUdrCount;   
};",
