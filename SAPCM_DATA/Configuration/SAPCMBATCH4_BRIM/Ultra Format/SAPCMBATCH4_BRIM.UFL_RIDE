\tstring ChargingLocation;
    date dtChSt : optional;
    date dtChEd : optional;
};

internal errorUdr{
    string errorCode;
    string errorMessage;
    drudr udr;    
};

internal CI_Int{
    string key;
    string ecsErrorCode;
