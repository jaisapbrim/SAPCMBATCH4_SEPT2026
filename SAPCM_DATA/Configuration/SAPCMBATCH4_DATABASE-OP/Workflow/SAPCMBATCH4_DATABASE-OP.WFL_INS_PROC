        "Name": "Analysis_1",
        "ID": -1939312021,
        "Classname": "com.digitalroute.wfc.analysis.StuffyMapperInsp",
        "Configuration": [
          {
            "Type": 1,
            "Classname": "com.digitalroute.wfc.analysis.StuffyMapperInsp",
            "Data": {
              "sourceCode": "final string PRF_DB = \"SAPCMBATCH4_COMMON.PRF_DB_SAPHANA\";
table tbIns;
string SELECT_INS_DATA = \"SELECT POLICYHOLDERID, CONTRACTACCOUNT, POLICYNUMBER, COVERAGEITEM, PRODUCTCODE, POLICYTYPE, MONTHLYPREMIUM, CURRENCY, POLICYSTATUS  from SAPCMUSER14.INSURANCE_REF_DATA\";
initialize{
    tbIns = tableCreate(PRF_DB,SELECT_INS_DATA); //data fetching
}
consume {
    string CAContract = input.CAContract;
    string CAProviderContractItemNumber = input.CAProviderContractItemNumber;
    //filteration
    /*table tbFiltered = tableLookup(tbIns,\"POLICYNUMBER\",\"=\",CAContract,\"COVERAGEITEM\",\"=\",CAProviderContractItemNumber);
    debug(\"CAContract:\"+CAContract+\" Filtered tb:\"+tbFiltered);
    if(tableRowCount(tbFiltered)>0){
        //processed
        udrRoute(input);
    }else{
        //filtered    
    }*/
    boolean found = false;
    for(int i = 0;i<tableRowCount(tbIns);i++){
        string tbCAContract = (string)tableGet(tbIns,i,\"POLICYNUMBER\");  
        string tbCAProviderContractItemNumber = (string)tableGet(tbIns,i,\"COVERAGEITEM\"); 
        
         if(CAContract == tbCAContract && CAProviderContractItemNumber == tbCAProviderContractItemNumber){
             found = true;
         } 
    }
    
    if(found == true){
        udrRoute(input);    
    }
}",
              "udrTypes": [
                {
                  "TypeName": "SAPCMBATCH4_DATABASE-OP.UFL_INS.AllIndHealth",
                  "FormatName": "SAPCMBATCH4_DATABASE-OP.UFL_INS",
