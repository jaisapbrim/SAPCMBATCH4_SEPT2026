      <xs:element minOccurs=\"0\" name=\"description\" type=\"core:String2000\"/>
      <xs:element name=\"rangeTableClassId\" type=\"core:String256\"/>
      <xs:element maxOccurs=\"unbounded\" minOccurs=\"0\" name=\"additionalInfo\" type=\"core:AdditionalInfo\"/>
