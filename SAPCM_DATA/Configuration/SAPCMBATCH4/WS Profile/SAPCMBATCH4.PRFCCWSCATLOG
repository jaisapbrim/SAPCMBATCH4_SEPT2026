  </xs:simpleType>
  <xs:simpleType name=\"Empty\">
    <xs:restriction base=\"xs:string\">
      <xs:length value=\"0\"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType abstract=\"true\" name=\"CatalogObject\">
    <xs:sequence>
      <xs:element name=\"id\" type=\"tns:String256\"/>
      <xs:element minOccurs=\"0\" name=\"description\" type=\"tns:String2000\"/>
      <xs:element maxOccurs=\"unbounded\" minOccurs=\"0\" name=\"additionalInfo\" type=\"tns:AdditionalInfo\"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType abstract=\"true\" name=\"Table\">
