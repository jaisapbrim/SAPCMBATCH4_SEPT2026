      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:simpleType name=\"ComputationMode\">
    <xs:restriction base=\"xs:string\">
      <xs:enumeration value=\"single\"/>
      <xs:enumeration value=\"cumulative\"/>
      <xs:enumeration value=\"rangeSizeCumulative\"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name=\"RangeTable\">
    <xs:sequence>
