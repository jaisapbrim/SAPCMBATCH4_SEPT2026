      <xs:element minOccurs=\"0\" name=\"validityStartDate\" type=\"core:Date\"/>
      <xs:element minOccurs=\"0\" name=\"validityEndDate\" type=\"core:Date\"/>
      <xs:element maxOccurs=\"unbounded\" name=\"row\" type=\"tns:RangeTableRow\"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name=\"RangeTableRow\">
    <xs:sequence>
      <xs:choice>
        <xs:element name=\"upperBound\" type=\"core:PositiveDecimal\"/>
        <xs:element name=\"unbounded\" nillable=\"true\"/>
      </xs:choice>
      <xs:element maxOccurs=\"15\" name=\"column\" type=\"tns:RangeTableColumn\"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name=\"RangeTableColumn\">
    <xs:sequence>
      <xs:element name=\"name\" type=\"core:String256\"/>
      <xs:choice>
        <xs:element name=\"string\" type=\"core:String2000\"/>
        <xs:element name=\"number\" type=\"core:Decimal\"/>
      </xs:choice>
    </xs:sequence>
  </xs:complexType>
</xs:schema>",
