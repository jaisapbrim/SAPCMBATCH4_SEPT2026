            "Data": {
              "sourceCode": "import ultra.openapi.SAPCMBATCH4_BRIM_CC.PRF_OPEN_API_EV;
import ultra.http;
import ultra.sapcc;
consume {
    if(instanceOf(input,RequestCycle)){
        RequestCycle req = (RequestCycle)input;
        EvChCons evCons = (EvChCons)req.openAPIUDR;
        debug(\"Req:\"+req);
        debug(\"Consumption:\"+evCons);
        
        
        CCCycleUDR ccCycle = createCCCycleUdr(evCons);
        ccCycle.freeField = req;
        debug(\"CC Request:\"+ccCycle);
        udrRoute(ccCycle,\"toCC\");
        
    }
}
CCCycleUDR createCCCycleUdr(EvChCons evCons){
    date stDate;
    strToDate(stDate,evCons.ChargingStartTime,\"dd/MM/yyyy HH:mm:ss\");
    
    CCCycleUDR cc = udrCreate(CCCycleUDR);
    ChargeUDR charge = udrCreate(ChargeUDR);
    
    //mandatory fields for charge request
    charge.chargeableItemName = \"ZEVC\";
    charge.consumptionDate = stDate;
    charge.serviceId = \"EVC\";
    charge.userId = evCons.VehicleId;
    
    double totalHrs;
    strToDouble(totalHrs, evCons.TotalChargingHrs);
    
    //CIC properties representing consumption details
    list<PropertyUDR> propList = listCreate(PropertyUDR);
    
    PropertyUDR chSt = udrCreate(PropertyUDR);
    chSt.name = \"ZZCHG_CHG_ST\";
    chSt.value = evCons.ChargingStartTime;
    listAdd(propList,chSt);
    
    PropertyUDR chEd = udrCreate(PropertyUDR);
    chEd.name = \"ZZCHG_CHG_ED\";
    chEd.value = evCons.ChargingEndTime;
    listAdd(propList,chEd);
    
    
    PropertyUDR chHrs = udrCreate(PropertyUDR);
    chHrs.name = \"ZZCHG_HRS\";
    chHrs.value = totalHrs;
    listAdd(propList,chHrs);
    
    PropertyUDR chVehId = udrCreate(PropertyUDR);
    chVehId.name = \"ZZVEHICLE_ID\";
    chVehId.value = evCons.VehicleId;
    listAdd(propList,chVehId);
    
    PropertyUDR chLoc = udrCreate(PropertyUDR);
    chLoc.name = \"ZZCHG_LOC\";
    chLoc.value = evCons.ChargingLocation;
    listAdd(propList,chLoc);
    
    PropertyUDR citQty = udrCreate(PropertyUDR);
    citQty.name = \"CIT_QUANTITY\";
    
    citQty.value = totalHrs;
    listAdd(propList,citQty);
        
    charge.ciPropertyList = propList;
    
    //charge execution context to control response
    charge.chargeExecutionContext = udrCreate(ChargeExecutionContextUDR);
    charge.chargeExecutionContext.resultChargedItemReturned = true;
    charge.chargeExecutionContext.resultNotificationReturned = true;
    charge.chargeExecutionContext.outputChargeableItemExported = true;
    charge.chargeExecutionContext.resultAccountOperationReturned = true;
    //charge.chargeExecutionContext.resultAllReturned = true;
    charge.chargeExecutionContext.resultChargeableItemInfoReturned = true;
    charge.chargeExecutionContext.resultChargingProcessInfoReturned = true;
    //charge.chargeExecutionContext.resultResponseItemReturned = true;
    cc.request = charge;
    return cc;
}",
