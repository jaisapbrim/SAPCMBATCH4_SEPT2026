      {
        "Name": "ccResp",
        "ID": 186233777,
        "Classname": "com.digitalroute.wfc.analysis.AnalysisRealtimeInsp",
        "Configuration": [
          {
            "Type": 1,
            "Classname": "com.digitalroute.wfc.analysis.AnalysisRealtimeInsp",
            "Data": {
              "sourceCode": "import ultra.openapi.SAPCMBATCH4_BRIM_CC.PRF_OPEN_API_EV;
import ultra.http;
import ultra.sapcc;
consume {
    CCCycleUDR cc = (CCCycleUDR)input;
    debug(\"CC Response:\"+cc);
    //Original API request
    RequestCycle req = (RequestCycle)cc.freeField;
    
    //Open API response structure
    ChargingResp chResp = udrCreate(ChargingResp);
    req.response = udrCreate(Response);
    req.response.openAPIUDR = chResp;
    
    //check if charging was successful or not
    if(instanceOf(cc.answer,ChargingResultUDR)){
        //success call
        ChargingResultUDR chargingResult = (ChargingResultUDR)cc.answer;
        list<NotificationUDR> liNotif = chargingResult.notifications;
        
        double amount;
        string vehId;
        string consDate;
        for(NotificationUDR notifUdr : liNotif){
            if(notifUdr.code == \"CM_ALERT\"){
                 list<NotificationArgumentUDR> notifArgList = notifUdr.notifArgList;
                 
                 for(NotificationArgumentUDR notifField : notifArgList){
                     if(notifField.name == \"computed.TOTAL_CHG_AMT\"){
                         strToDouble(amount, (string)notifField.value);
                     }
                     if(notifField.name == \"item.ZZVEHICLE_ID\"){
                         vehId = (string)notifField.value;
                     }
                     if(notifField.name == \"default.consumption_date\"){
                         consDate = (string)notifField.value;
                     }
                 }
            }
        }
        req.response.statusCode = 200;
        chResp.amount = amount;
        chResp.status = \"SUCCESS\";
        chResp.message = \"VehicalId:\"+vehId+\" Consumption date:\"+consDate;
        
    }else if(instanceOf(cc.answer,CCExceptionUDR)){
        CCExceptionUDR exception = (CCExceptionUDR)cc.answer;
        //failure call
        chResp.amount = 0;
        chResp.status = \"FAILED\";
        chResp.message = exception.message;
        req.response.statusCode = 500;
    }
    debug(\"Http response:\"+req);
    udrRoute(req,\"toHttpResp\");
}",
