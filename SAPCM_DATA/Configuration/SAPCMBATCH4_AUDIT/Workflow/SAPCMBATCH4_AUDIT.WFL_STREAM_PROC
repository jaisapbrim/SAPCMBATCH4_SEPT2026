        auditAdd(PRF_ADT_COLL,TB_COLL_ADT,\"OUT_REC_COUNT\",1);
        udrRoute(input,\"toProcess\");
    }else{
        auditAdd(PRF_ADT_COLL,TB_COLL_ADT,\"FILTERED_REC_COUNT\",1);
        udrRoute(input,\"toFilter\");   
    }
}
drain{
    auditSet(PRF_ADT_COLL, TB_COLL_ADT, \"WF_TYPE\", \"PROCESSING\");
