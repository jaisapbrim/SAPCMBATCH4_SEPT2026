              "sourceCode": "final string PRF_ADT_COLL = \"SAPCMBATCH4_AUDIT.PRF_ADT_PROC\";
final string TB_COLL_ADT = \"SAPCMUSER14.TB_ADT_STREAM_PROC\";

map<string,boolean> mpDup;
beginBatch{
    mpDup = mapCreate(string,boolean);        
}
consume {
    auditAdd(PRF_ADT_COLL,TB_COLL_ADT,\"TOTAL_REC_COUNT\",1);
    string key = input.BP+\"_\"+input.Service;
    if(!mapContains(mpDup,key)){
        mapSet(mpDup,key,true);
        udrRoute(input,\"unique\");    
    }else{
        udrRoute(input,\"dup\");
        auditAdd(PRF_ADT_COLL,TB_COLL_ADT,\"DUP_REC_COUNT\",1);
    
    }
