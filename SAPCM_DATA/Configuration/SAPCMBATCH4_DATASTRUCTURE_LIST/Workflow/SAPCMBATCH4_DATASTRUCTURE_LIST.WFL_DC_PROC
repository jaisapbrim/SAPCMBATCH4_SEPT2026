            "Data": {
              "sourceCode": "list<string> liEnv;
initialize{
    liEnv = listCreate(string,\"PRD\",\"TST\");
}
consume {
    //S;SRV00002;C10001;40;2000;50000;DEV;202610
    for(string env : liEnv){
        if(input.Environment == env){
           udrRoute(input);
           break;     
        }    
    }
    /*
    int i = listFindIndex(liEnv,string ele , ele == input.Environment);
    if(i > -1){
        udrRoute(input);
    }
    */
}",
