            "Data": {
              "sourceCode": "consume {
    map<string,int> mapScore = mapCreate(string,int);
    
    mapSet(mapScore,\"Raju\",100);
    mapSet(mapScore,\"Rani\",90);
    mapSet(mapScore,\"Vani\",90);
    mapSet(mapScore,\"Raju\",89);
    
    debug(mapScore);
    //sleep(100);
    mapRemove(mapScore,\"Raju\");
    debug(mapScore);
    
    if(mapContains(mapScore,\"Vani\")){
        int vaniScore = mapGet(mapScore,\"Vani\");
        debug(\"vaniScore:\"+vaniScore);
    }
    
    list<string> liKeys = mapKeys(mapScore);
    debug(liKeys);
    
    list<int> liValues = mapValues(mapScore);
    debug(liValues);
}",
