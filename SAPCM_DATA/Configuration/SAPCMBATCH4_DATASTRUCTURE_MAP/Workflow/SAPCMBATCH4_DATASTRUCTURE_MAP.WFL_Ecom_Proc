            "Data": {
              "sourceCode": "import apl.SAPCMBATCH4_DATASTRUCTURE_MAP.APL_FUNC;
map<string,long> mapTotalSpent;
list<EcomOrd> liInput;


final string ERR_DUP = \"ERR_DUP_RECORD\";
final string ERR_NO_THRESHOLD = \"ERR_THRESHOLD_CONFIGURED\";

initialize{
    initializeMaps();     
}
beginBatch{
    mapTotalSpent = mapCreate(string,long);
    liInput = listCreate(EcomOrd);
   
}
consume {
    listAdd(liInput,input);
    
    //key --> cust, value --> sum of order amt
    string cust = input.Customer_ID;
    
    if(mapContains(mapTotalSpent,cust)){
        //already few orders exist in map, add the current amount to existing entry in map
        long prevAmt = mapGet(mapTotalSpent,cust);
        long newAmt = prevAmt + input.Order_Amount;
        mapSet(mapTotalSpent,cust,newAmt);    
    }else{
        //first order
        mapSet(mapTotalSpent,cust,input.Order_Amount);
    }
    debug(input);
    debug(mapTotalSpent);
    sleep(100);
}
drain {
    //debug(mapTotalSpent);   
    
    for(EcomOrd ecom : liInput){
        string cus = ecom.Customer_ID;
        if(mapContains(mapTotalSpent,cus)){
            long amt = mapGet(mapTotalSpent,cus);
            long thAmt = mapGet(mpCustThr,cus);
            debug(mpCustThr);
            if(amt >= thAmt){
                debug(\"VIP Order:\"+ecom);    
            }else{
                debug(\"STD Order:\"+ecom); 
            }
                    
        }else{
            udrRoute(ecom,\"exc\");    
        }
        
    } 
}",
